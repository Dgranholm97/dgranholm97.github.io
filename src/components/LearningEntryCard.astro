---
interface Entry {
  period: string;
  title: string;
  status: string;
  summary: string;
  details?: string;
  skills: readonly string[];
  evidence?: readonly string[];
}

interface Props {
  entry: Entry;
  expanded?: boolean;
}

const { entry, expanded = false } = Astro.props;
---

<article class="rounded-lg border border-ink/12 bg-white/55 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
  <div class="flex flex-wrap items-start justify-between gap-3">
    <div>
      <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-teal">
        {entry.period}
      </p>
      <h3 class="mt-1 text-2xl font-extrabold text-ink">{entry.title}</h3>
    </div>
    <span class="rounded-full border border-ink/12 bg-paper px-3 py-1 text-sm font-bold text-ink-soft">
      {entry.status}
    </span>
  </div>

  <p class="mt-4 leading-7 text-ink-soft">{entry.summary}</p>
  {expanded && entry.details && <p class="mt-4 leading-7 text-ink-soft">{entry.details}</p>}

  <ul class="mt-5 flex flex-wrap gap-2" aria-label={`${entry.title} skills`}>
    {
      entry.skills.map((skill) => (
        <li class="rounded-full bg-ink px-3 py-1 text-sm font-bold text-paper">{skill}</li>
      ))
    }
  </ul>

  {
    expanded && entry.evidence && (
      <div class="mt-6 border-t border-ink/10 pt-5">
        <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Evidence to collect</h4>
        <ul class="mt-3 grid gap-2 text-ink-soft">
          {entry.evidence.map((item) => <li class="leading-7">{item}</li>)}
        </ul>
      </div>
    )
  }
</article>
