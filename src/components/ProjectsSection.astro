---
import SectionIntro from './SectionIntro.astro';
import ProjectCard from './ProjectCard.astro';

interface Project {
  slug: string;
  title: string;
  stage: string;
  summary: string;
  tags: readonly string[];
}

interface Props {
  eyebrow: string;
  title: string;
  body: string;
  items: readonly Project[];
}

const { eyebrow, title, body, items } = Astro.props;
---

<section id="projects" class="scroll-mt-24 py-20 sm:py-24" aria-labelledby="projects-title">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <SectionIntro eyebrow={eyebrow} title={title} body={body} titleId="projects-title" />

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {items.map((project) => <ProjectCard project={project} />)}
    </div>
  </div>
</section>
