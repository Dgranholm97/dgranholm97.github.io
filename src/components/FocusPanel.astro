---
interface Props {
  items: string[];
}

const { items } = Astro.props;
---

<aside
  class="sketch-card relative grid min-h-[420px] content-end overflow-hidden rounded-lg sm:min-h-[540px]"
  aria-label="Portfolio focus areas"
>
  <div class="absolute inset-0">
    <img
      class="h-full w-full object-cover opacity-90 mix-blend-multiply"
      src="/images/robot-sketch.png"
      alt="Hand-drawn engineering sketch of a small mobile robot with coordinate axes"
      loading="eager"
      decoding="async"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-paper via-paper/25 to-transparent"></div>
  </div>

  <div class="absolute left-6 top-6 rounded-lg border border-ink/15 bg-paper/80 px-3 py-2 backdrop-blur-sm">
    <p class="draft-label text-xs font-extrabold text-copper">Concept sketch</p>
    <p class="mt-1 text-sm font-bold text-ink-soft">mobile robot system</p>
  </div>

  <ul class="relative grid gap-2.5 p-7">
    {
      items.map((item) => (
        <li class="flex min-h-12 items-center rounded-lg border border-ink/12 bg-paper/88 px-4 font-bold text-[#243337] shadow-[0_10px_30px_rgba(23,33,36,0.08)] backdrop-blur-sm">
          {item}
        </li>
      ))
    }
  </ul>
</aside>
