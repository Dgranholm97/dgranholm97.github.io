---
import SketchFigure from './SketchFigure.astro';
import type { RoboticsCurriculum } from '../data/roboticsCurriculum';

interface Props {
  curriculum: RoboticsCurriculum;
}

const { curriculum } = Astro.props;

const allMaterials = curriculum.phases.flatMap((phase) =>
  (phase.materials ?? []).map((material) => ({
    ...material,
    phase: phase.title,
  })),
);

const capstonePhase = curriculum.phases.find((phase) => 'specializationOptions' in phase);

const formatFieldName = (field: string) =>
  field
    .replace(/([A-Z])/g, ' $1')
    .replace(/^./, (letter) => letter.toUpperCase());

const statusClasses = {
  Planned: 'bg-paper text-ink-soft border-ink/12',
  'In Progress': 'bg-teal text-paper border-teal',
  Completed: 'bg-ink text-paper border-ink',
};
---

<section class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
  <div class="grid gap-10 lg:grid-cols-[1fr_0.42fr] lg:items-end">
    <div>
      <p class="mb-4 text-[0.82rem] font-extrabold uppercase tracking-[0.14em] text-copper">
        Robotics roadmap
      </p>
      <h1 class="text-[clamp(3rem,10vw,6.4rem)] font-extrabold leading-[0.92] tracking-normal text-ink">
        {curriculum.title}
      </h1>
      <p class="mt-6 max-w-3xl text-lg leading-8 text-ink-soft sm:text-xl sm:leading-9">
        {curriculum.subtitle}
      </p>
    </div>

    <div class="grid gap-4">
      <aside class="rounded-lg border border-ink/12 bg-panel/80 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
        <dl class="grid gap-4">
          <div>
            <dt class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Timeline</dt>
            <dd class="mt-1 text-2xl font-extrabold text-ink">{curriculum.targetTimeline}</dd>
          </div>
          <div>
            <dt class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Weekly pace</dt>
            <dd class="mt-1 text-2xl font-extrabold text-ink">{curriculum.weeklyCommitment}</dd>
          </div>
        </dl>
      </aside>
      <SketchFigure
        src="/images/robot-arm-sketch.png"
        alt="Hand-drawn engineering sketch of a robotic arm manipulator"
        label="motion planning sketch"
        note="manipulation track"
        className="min-h-64"
        imageClassName="h-full min-h-64 object-cover"
      />
    </div>
  </div>

  <div class="mt-10 grid gap-4 lg:grid-cols-[1.1fr_0.9fr]">
    <article class="rounded-lg border border-ink/12 bg-white/55 p-5">
      <h2 class="text-2xl font-extrabold text-ink">Why this curriculum exists</h2>
      <p class="mt-4 leading-7 text-ink-soft">{curriculum.background}</p>
      <p class="mt-4 leading-7 text-ink-soft">{curriculum.primaryGoal}</p>
      <p class="mt-4 font-bold leading-7 text-ink">{curriculum.portfolioThesis}</p>
    </article>

    <article class="rounded-lg border border-ink/12 bg-white/55 p-5">
      <h2 class="text-2xl font-extrabold text-ink">Role targets</h2>
      <ul class="mt-4 grid gap-2">
        {curriculum.roleTargets.map((role) => <li class="rounded-lg bg-panel/80 px-4 py-3 font-bold text-ink-soft">{role}</li>)}
      </ul>
    </article>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="focus-title">
  <div class="max-w-3xl">
    <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">Focus areas</p>
    <h2 id="focus-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
      Software-heavy robotics skills
    </h2>
  </div>
  <ul class="mt-8 flex flex-wrap gap-2">
    {curriculum.focusAreas.map((area) => <li class="rounded-full bg-ink px-3 py-1 text-sm font-bold text-paper">{area}</li>)}
  </ul>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="timeline-title">
  <div class="max-w-3xl">
    <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">Timeline overview</p>
    <h2 id="timeline-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
      Nine to twelve month roadmap
    </h2>
  </div>
  <ol class="mt-8 grid gap-3 md:grid-cols-2 xl:grid-cols-4">
    {
      curriculum.phases.map((phase) => (
        <li class="rounded-lg border border-ink/12 bg-panel/80 p-4">
          <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-teal">{phase.timeline}</p>
          <h3 class="mt-2 font-extrabold leading-tight text-ink">{phase.title}</h3>
          <span class:list={['mt-4 inline-flex rounded-full border px-3 py-1 text-sm font-bold', statusClasses[phase.status] ?? statusClasses.Planned]}>
            {phase.status}
          </span>
        </li>
      ))
    }
  </ol>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="phases-title">
  <div class="max-w-3xl">
    <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">Curriculum phases</p>
    <h2 id="phases-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
      Learning goals, materials, and portfolio projects
    </h2>
  </div>

  <div class="mt-10 grid gap-6">
    {
      curriculum.phases.map((phase) => (
        <article id={phase.id} class="rounded-lg border border-ink/12 bg-white/55 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)] lg:p-6">
          <div class="grid gap-6 lg:grid-cols-[0.58fr_1.42fr]">
            <div>
              <div class="flex flex-wrap items-center gap-3">
                <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-teal">{phase.timeline}</p>
                <span class:list={['rounded-full border px-3 py-1 text-sm font-bold', statusClasses[phase.status] ?? statusClasses.Planned]}>
                  {phase.status}
                </span>
              </div>
              <h3 class="mt-3 text-3xl font-extrabold leading-tight text-ink">{phase.title}</h3>
              <p class="mt-4 leading-7 text-ink-soft">{phase.summary}</p>
            </div>

            <div class="grid gap-4 xl:grid-cols-3">
              <div class="rounded-lg bg-panel/80 p-4">
                <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Learning goals</h4>
                <ul class="mt-3 grid gap-2 text-ink-soft">
                  {phase.learningGoals.map((goal) => <li class="leading-6">{goal}</li>)}
                </ul>
              </div>
              <div class="rounded-lg bg-panel/80 p-4">
                <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Materials</h4>
                <ul class="mt-3 grid gap-3 text-ink-soft">
                  {
                    (phase.materials ?? []).map((material) => (
                      <li class="leading-6">
                        {material.url ? (
                          <a class="font-bold text-teal no-underline hover:text-ink" href={material.url}>{material.title}</a>
                        ) : (
                          <span class="font-bold text-ink">{material.title}</span>
                        )}
                        <span class="block text-sm">{material.type}</span>
                      </li>
                    ))
                  }
                  {(phase.materials ?? []).length === 0 && <li class="leading-6">Add resources later.</li>}
                </ul>
              </div>
              <div class="rounded-lg bg-panel/80 p-4">
                <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Project</h4>
                <h5 class="mt-3 text-xl font-extrabold leading-tight text-ink">{phase.project.title}</h5>
                <p class="mt-3 leading-6 text-ink-soft">{phase.project.shortDescription}</p>
              </div>
            </div>
          </div>

          <div class="mt-6 grid gap-4 lg:grid-cols-[0.9fr_1.1fr]">
            <div class="rounded-lg border border-ink/10 bg-paper/70 p-4">
              <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Build checklist</h4>
              <ul class="mt-3 grid gap-2 text-ink-soft sm:grid-cols-2">
                {phase.project.buildChecklist.map((item) => <li class="leading-6">{item}</li>)}
              </ul>
            </div>

            <div class="rounded-lg border border-ink/10 bg-paper/70 p-4">
              <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Portfolio placeholders</h4>
              <div class="mt-3 grid gap-2 sm:grid-cols-2">
                {
                  Object.entries(phase.project.portfolioFields).map(([field, value]) => (
                    <div class="rounded-lg bg-white/65 px-3 py-2">
                      <p class="text-sm font-bold text-ink">{formatFieldName(field)}</p>
                      <p class="text-sm text-ink-soft">
                        {Array.isArray(value) ? 'Add images or media later' : value || 'To be filled in'}
                      </p>
                    </div>
                  ))
                }
              </div>
            </div>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="projects-title">
  <div class="max-w-3xl">
    <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">Project portfolio</p>
    <h2 id="projects-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
      Project cards to fill in over time
    </h2>
  </div>

  <div class="mt-8 grid gap-4 md:grid-cols-2 xl:grid-cols-3">
    {
      curriculum.phases.map((phase) => (
        <article class="flex min-h-80 flex-col rounded-lg border border-ink/12 bg-panel/80 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
          <div class="flex flex-wrap items-start justify-between gap-3">
            <h3 class="text-2xl font-extrabold leading-tight text-ink">{phase.project.title}</h3>
            <span class:list={['rounded-full border px-3 py-1 text-sm font-bold', statusClasses[phase.project.portfolioFields.status] ?? statusClasses.Planned]}>
              {phase.project.portfolioFields.status}
            </span>
          </div>
          <p class="mt-4 leading-7 text-ink-soft">{phase.project.shortDescription}</p>
          <ul class="mt-5 flex flex-wrap gap-2">
            {phase.project.skills.map((skill) => <li class="rounded-full bg-paper px-3 py-1 text-sm font-bold text-ink-soft">{skill}</li>)}
          </ul>
          <div class="mt-auto pt-6">
            <a class="font-extrabold text-teal no-underline hover:text-ink" href={`#${phase.id}`}>
              View phase details
            </a>
          </div>
        </article>
      ))
    }
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="materials-title">
  <div class="max-w-3xl">
    <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">Materials</p>
    <h2 id="materials-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
      Resources and references
    </h2>
  </div>
  <div class="mt-8 grid gap-4 md:grid-cols-2">
    {
      allMaterials.map((material) => (
        <article class="rounded-lg border border-ink/12 bg-white/55 p-5">
          <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">{material.type}</p>
          <h3 class="mt-2 text-2xl font-extrabold leading-tight text-ink">
            {material.url ? <a class="text-inherit no-underline hover:text-teal" href={material.url}>{material.title}</a> : material.title}
          </h3>
          <p class="mt-3 leading-7 text-ink-soft">{material.notes}</p>
          <p class="mt-4 text-sm font-bold text-teal">{material.phase}</p>
        </article>
      ))
    }
  </div>
</section>

{
  capstonePhase && 'specializationOptions' in capstonePhase && (
    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="capstone-title">
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">Capstone</p>
        <h2 id="capstone-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
          Specialization options
        </h2>
      </div>
      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {capstonePhase.specializationOptions.map((option) => (
          <article class="rounded-lg border border-ink/12 bg-panel/80 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
            <h3 class="text-2xl font-extrabold leading-tight text-ink">{option.title}</h3>
            <p class="mt-3 text-lg font-bold text-teal">{option.capstoneIdea}</p>
            <p class="mt-4 leading-7 text-ink-soft">{option.projectDescription}</p>
            <div class="mt-5 grid gap-4 sm:grid-cols-2">
              <div>
                <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Best for</h4>
                <ul class="mt-2 grid gap-1 text-ink-soft">{option.bestFor.map((item) => <li>{item}</li>)}</ul>
              </div>
              <div>
                <h4 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Emphasize</h4>
                <ul class="mt-2 grid gap-1 text-ink-soft">{option.emphasize.map((item) => <li>{item}</li>)}</ul>
              </div>
            </div>
          </article>
        ))}
      </div>
    </section>
  )
}

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="operating-system-title">
  <div class="grid gap-4 lg:grid-cols-3">
    <article class="rounded-lg border border-ink/12 bg-white/55 p-5">
      <h2 id="operating-system-title" class="text-2xl font-extrabold text-ink">Weekly operating rhythm</h2>
      <dl class="mt-4 grid gap-3">
        {
          Object.entries(curriculum.weeklySchedule).map(([label, value]) => (
            <div class="rounded-lg bg-panel/80 p-3">
              <dt class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">{formatFieldName(label)}</dt>
              <dd class="mt-1 font-bold text-ink-soft">{value}</dd>
            </div>
          ))
        }
      </dl>
    </article>

    <article class="rounded-lg border border-ink/12 bg-white/55 p-5">
      <h2 class="text-2xl font-extrabold text-ink">Portfolio standards</h2>
      <ul class="mt-4 grid gap-2 text-ink-soft">
        {curriculum.portfolioStandards.map((standard) => <li class="leading-6">{standard}</li>)}
      </ul>
    </article>

    <article class="rounded-lg border border-ink/12 bg-white/55 p-5">
      <h2 class="text-2xl font-extrabold text-ink">Recommended hardware</h2>
      <div class="mt-4 grid gap-4">
        {
          Object.entries(curriculum.recommendedHardware).map(([tier, items]) => (
            <div>
              <h3 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">{formatFieldName(tier)}</h3>
              <ul class="mt-2 grid gap-1 text-ink-soft">{items.map((item) => <li>{item}</li>)}</ul>
            </div>
          ))
        }
      </div>
    </article>
  </div>
</section>

<section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="progress-title">
  <div class="rounded-lg border border-ink/12 bg-panel/80 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
    <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">Progress log</p>
    <h2 id="progress-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
      Blank update template
    </h2>
    <div class="mt-6 grid gap-3 md:grid-cols-3">
      {
        Object.entries(curriculum.progressLog[0]).map(([field, value]) => (
          <div class="rounded-lg bg-paper/80 p-4">
            <p class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">{formatFieldName(field)}</p>
            <p class="mt-2 text-ink-soft">{value || 'To be filled in'}</p>
          </div>
        ))
      }
    </div>
  </div>
</section>
