---
import type { Project } from '../data/projects';

interface Props {
  project: Project;
}

const { project } = Astro.props;
---

<article class="flex min-h-72 flex-col rounded-lg border border-ink/12 bg-panel/80 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
  <div class="flex flex-col items-start gap-3 xl:flex-row xl:justify-between xl:gap-4">
    <h3 class="text-2xl font-extrabold leading-tight text-ink">
      <a class="text-inherit no-underline hover:text-teal focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal" href={`/projects/${project.slug}/`}>
        {project.title}
      </a>
    </h3>
    <span class="max-w-full rounded-full bg-white/75 px-3 py-1 text-sm font-bold text-teal">
      {project.stage}
    </span>
  </div>
  <p class="mt-5 leading-7 text-ink-soft">{project.summary}</p>
  <ul class="mt-auto flex flex-wrap gap-2 pt-6" aria-label={`${project.title} tags`}>
    {
      project.tags.map((tag) => (
        <li class="rounded-full border border-ink/12 bg-paper px-3 py-1 text-sm font-bold text-ink-soft">
          {tag}
        </li>
      ))
    }
  </ul>
</article>
