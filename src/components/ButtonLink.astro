---
interface Props {
  href: string;
  label: string;
  variant?: 'primary' | 'secondary';
}

const { href, label, variant = 'secondary' } = Astro.props;

const baseClasses =
  'inline-flex min-h-11 items-center justify-center rounded-lg border border-ink px-5 text-base font-bold no-underline transition duration-150 ease-out hover:-translate-y-0.5 hover:bg-ink hover:text-paper focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal';

const variantClasses = {
  primary: 'bg-ink text-paper',
  secondary: 'bg-transparent text-ink',
};
---

<a class:list={[baseClasses, variantClasses[variant]]} href={href}>{label}</a>
