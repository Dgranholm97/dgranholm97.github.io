---
interface Props {
  eyebrow: string;
  title: string;
  body: string;
  titleId?: string;
}

const { eyebrow, title, body, titleId } = Astro.props;
---

<div class="max-w-3xl">
  <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">
    {eyebrow}
  </p>
  <h2 id={titleId} class="text-4xl font-extrabold leading-tight tracking-normal text-ink sm:text-5xl">
    {title}
  </h2>
  <p class="mt-5 text-lg leading-8 text-ink-soft">
    {body}
  </p>
</div>
