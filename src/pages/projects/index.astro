---
import PageHeader from '../../components/PageHeader.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { projects, projectsIntro } from '../../data/projects';
import { siteNav } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout title="Projects | Dylan Granholm" description={projectsIntro.body}>
  <SiteHeader items={siteNav} />
  <main>
    <PageHeader eyebrow={projectsIntro.eyebrow} title={projectsIntro.title} body={projectsIntro.body} />

    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-label="Project case studies">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </section>
  </main>
</BaseLayout>
