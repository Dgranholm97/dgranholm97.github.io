---
import SketchFigure from '../../components/SketchFigure.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { projects } from '../../data/projects';
import { siteNav } from '../../data/site';
import BaseLayout from '../../layouts/BaseLayout.astro';

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
---

<BaseLayout title={`${project.title} | Dylan Granholm`} description={project.summary}>
  <SiteHeader items={siteNav} />
  <main>
    <article>
      <header class="mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:py-20">
        <a class="text-sm font-extrabold text-teal no-underline hover:text-ink" href="/projects/">
          Back to projects
        </a>
        <div class="mt-6 grid gap-8 lg:grid-cols-[1fr_0.48fr] lg:items-end">
          <div>
            <p class="mb-4 text-[0.82rem] font-extrabold uppercase tracking-[0.14em] text-copper">
              {project.stage}
            </p>
            <h1 class="text-[clamp(3rem,10vw,6.4rem)] font-extrabold leading-[0.92] tracking-normal text-ink">
              {project.title}
            </h1>
            <p class="mt-6 max-w-3xl text-lg leading-8 text-ink-soft sm:text-xl sm:leading-9">
              {project.summary}
            </p>
          </div>
          <div class="grid gap-4">
            {
              project.sketch && (
                <SketchFigure
                  src={project.sketch.src}
                  alt={project.sketch.alt}
                  label={project.sketch.label}
                  note={project.stage}
                  className="min-h-72"
                  imageClassName="h-full min-h-72 object-cover"
                  objectPosition={project.sketch.position ?? 'center'}
                />
              )
            }
            <div class="rounded-lg border border-ink/12 bg-panel/80 p-5">
              <h2 class="text-sm font-extrabold uppercase tracking-[0.12em] text-copper">Stack</h2>
              <ul class="mt-4 flex flex-wrap gap-2">
                {project.stack.map((item) => <li class="rounded-full bg-ink px-3 py-1 text-sm font-bold text-paper">{item}</li>)}
              </ul>
            </div>
          </div>
        </div>
      </header>

      <section class="mx-auto grid max-w-6xl gap-4 px-4 pb-20 sm:px-6 sm:pb-24 lg:grid-cols-2" aria-label="Project details">
        <div class="rounded-lg border border-ink/12 bg-white/55 p-6">
          <h2 class="text-2xl font-extrabold text-ink">Problem</h2>
          <p class="mt-4 leading-7 text-ink-soft">{project.problem}</p>
        </div>
        <div class="rounded-lg border border-ink/12 bg-white/55 p-6">
          <h2 class="text-2xl font-extrabold text-ink">Approach</h2>
          <p class="mt-4 leading-7 text-ink-soft">{project.approach}</p>
        </div>
        <div class="rounded-lg border border-ink/12 bg-panel/80 p-6">
          <h2 class="text-2xl font-extrabold text-ink">Evidence to show</h2>
          <ul class="mt-4 grid gap-3 text-ink-soft">
            {project.evidence.map((item) => <li class="leading-7">{item}</li>)}
          </ul>
        </div>
        <div class="rounded-lg border border-ink/12 bg-panel/80 p-6">
          <h2 class="text-2xl font-extrabold text-ink">Lessons so far</h2>
          <ul class="mt-4 grid gap-3 text-ink-soft">
            {project.lessons.map((item) => <li class="leading-7">{item}</li>)}
          </ul>
        </div>
        <div class="rounded-lg border border-ink/12 bg-white/55 p-6 lg:col-span-2">
          <h2 class="text-2xl font-extrabold text-ink">Next iteration</h2>
          <ul class="mt-4 grid gap-3 text-ink-soft sm:grid-cols-3">
            {project.nextSteps.map((item) => <li class="leading-7">{item}</li>)}
          </ul>
        </div>
      </section>
    </article>
  </main>
</BaseLayout>
