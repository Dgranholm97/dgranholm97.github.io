---
import Hero from '../components/Hero.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hero, homePaths, siteNav } from '../data/site';
---

<BaseLayout title="Dylan Granholm" description="Portfolio site for Dylan Granholm.">
  <SiteHeader items={siteNav} />
  <main>
    <div class="mx-auto grid min-h-[calc(100vh-73px)] max-w-6xl place-items-center px-4 py-12 sm:px-6 sm:py-16">
      <Hero
        eyebrow={hero.eyebrow}
        title={hero.title}
        body={hero.body}
        actions={hero.actions}
        focusAreas={hero.focusAreas}
      />
    </div>

    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-labelledby="next-title">
      <div class="max-w-3xl">
        <p class="mb-3 text-[0.78rem] font-extrabold uppercase tracking-[0.14em] text-copper">
          Lab notebook
        </p>
        <h2 id="next-title" class="text-4xl font-extrabold leading-tight text-ink sm:text-5xl">
          Choose a path through the lab
        </h2>
      </div>

      <div class="mt-8 grid gap-4 md:grid-cols-2">
        {
          homePaths.map((path) => (
            <a
              class="sketch-card group rounded-lg p-6 text-ink no-underline transition hover:-translate-y-1 hover:border-teal/40 focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-teal"
              href={path.href}
            >
              <div class="relative">
                <p class="draft-label text-sm font-extrabold text-copper">{path.eyebrow}</p>
                <h3 class="mt-3 text-3xl font-extrabold leading-tight">{path.title}</h3>
                <p class="mt-4 leading-7 text-ink-soft">{path.body}</p>
                <span class="mt-6 inline-flex font-extrabold text-teal group-hover:text-ink">{path.cta}</span>
              </div>
            </a>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
