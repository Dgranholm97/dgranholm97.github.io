---
import Hero from '../components/Hero.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { hero } from '../data/home';
---

<BaseLayout title="Dylan Granholm" description="Portfolio site for Dylan Granholm.">
  <main class="grid min-h-screen place-items-start px-4 py-8 sm:px-6 sm:py-12 md:place-items-center">
    <Hero
      eyebrow={hero.eyebrow}
      title={hero.title}
      body={hero.body}
      actions={hero.actions}
      focusAreas={hero.focusAreas}
    />
  </main>
</BaseLayout>
