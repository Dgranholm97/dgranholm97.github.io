---
import PageHeader from '../components/PageHeader.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { about, siteNav } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Dylan Granholm" description={about.body}>
  <SiteHeader items={siteNav} />
  <main>
    <PageHeader eyebrow={about.eyebrow} title={about.title} body={about.body} />

    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-label="Portfolio principles">
      <div class="grid gap-4 md:grid-cols-3">
        {
          about.principles.map((principle) => (
            <div class="rounded-lg border border-ink/12 bg-panel/80 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
              <p class="text-xl font-extrabold leading-8 text-ink">{principle}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
