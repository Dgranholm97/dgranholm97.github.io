---
import PageHeader from '../components/PageHeader.astro';
import SketchFigure from '../components/SketchFigure.astro';
import SiteHeader from '../components/SiteHeader.astro';
import { about, siteNav } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About | Dylan Granholm" description={about.body}>
  <SiteHeader items={siteNav} />
  <main>
    <PageHeader eyebrow={about.eyebrow} title={about.title} body={about.body} />

    <section class="mx-auto grid max-w-6xl gap-6 px-4 pb-20 sm:px-6 sm:pb-24 lg:grid-cols-[0.95fr_1.05fr] lg:items-center" aria-label="Robotics transition sketch">
      <SketchFigure
        src="/images/humanoid-sketch.png"
        alt="Hand-drawn engineering sketch of a humanoid robot prototype"
        label="humanoid sketch"
        note="systems + autonomy"
        className="min-h-[420px]"
        imageClassName="h-full min-h-[420px] object-cover object-top"
      />
      <div class="rounded-lg border border-ink/12 bg-white/55 p-6">
        <p class="draft-label text-sm font-extrabold text-copper">Design note</p>
        <h2 class="mt-3 text-3xl font-extrabold leading-tight text-ink">
          The site should feel like an engineering sketchbook.
        </h2>
        <p class="mt-4 leading-7 text-ink-soft">
          The robot drawings are visual shorthand for the kind of work this portfolio is meant to document:
          software, sensors, simulation, control loops, testing, and the messy path from concept to reliable behavior.
        </p>
      </div>
    </section>

    <section class="mx-auto max-w-6xl px-4 pb-20 sm:px-6 sm:pb-24" aria-label="Portfolio principles">
      <div class="grid gap-4 md:grid-cols-3">
        {
          about.principles.map((principle) => (
            <div class="rounded-lg border border-ink/12 bg-panel/80 p-5 shadow-[0_18px_50px_rgba(27,44,50,0.08)]">
              <p class="text-xl font-extrabold leading-8 text-ink">{principle}</p>
            </div>
          ))
        }
      </div>
    </section>
  </main>
</BaseLayout>
